singularity run \
   --hostname slurmctld \
   --bind /nfs/turbo/umms-kgontjes/containers/phastest/phastest-app-docker/sub_programs/ncbi-blast-2.3.0+:/BLAST+ \
   --bind /nfs/turbo/umms-kgontjes/containers/phastest/phastest-app-docker/sub_programs/ncbi-blast-2.3.0+:/root/BLAST+ \
